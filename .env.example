# Copy this file to .env and change what you need. Every setting is optional.

# Web server
PORT=3000
# 0.0.0.0 lets phones on the same Wi-Fi open the shop; use 127.0.0.1 to keep it on this computer only
HOST=0.0.0.0

# First admin password (used only when the database is created). Leave empty to get a random one,
# printed in the terminal and saved in data/ADMIN-LOGIN.txt
ADMIN_PASSWORD=

# Where the SQLite database and uploaded photos live
DATA_DIR=data

# Seed two weeks of sample orders on first start (1 = yes, 0 = start with no orders)
SEED_DEMO=1

# Show the demo seller login on the console sign-in page (defaults to SEED_DEMO). Set 0 for a real shop.
DEMO_HINTS=1

# Sign-in sessions last this many days
SESSION_DAYS=14

# Largest product photo, in MB
MAX_UPLOAD_MB=3

# Orders allowed per network address per 10 minutes
ORDER_LIMIT=40

# Sign-in attempts allowed per network address per 10 minutes (each account also locks after 8 wrong tries)
LOGIN_LIMIT=30

# Set to 1 behind a hosting proxy (Render, Railway, nginx) so client addresses and HTTPS are detected
TRUST_PROXY=0

# Time zone for "today" on the dashboard
TZ=Asia/Kolkata

# Print one line per request in the terminal (1/0)
LOG=1
